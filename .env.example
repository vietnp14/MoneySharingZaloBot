PORT=3000

# Zalo Bot API
ZALO_BOT_TOKEN=replace_me
ZALO_WEBHOOK_SECRET=replace_me

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6-luna

# Storage: firestore or memory
STORAGE_DRIVER=firestore
GOOGLE_CLOUD_PROJECT=replace_me

# Optional for local service-account auth.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Better for cloud hosts. Use exactly one of these if the host cannot mount a JSON file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
